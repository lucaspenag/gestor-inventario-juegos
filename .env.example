# Copiar este archivo como .env y completar con los valores reales.
SECRET_KEY=reemplazar_por_una_passkey

DATABASE_URL=

# Catalogo de juegos (no necesitan clave).
# La XML API2 oficial de BoardGameGeek exige un token registrado, asi que se
# busca por nombre en Wikidata y el detalle se trae del JSON de la web de BGG.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIDATA_TIMEOUT=20
GEEKDO_API_URL=https://api.geekdo.com/api
BGG_TIMEOUT=10

# Usuario administrador que se crea automaticamente la primera vez
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@tiendadejuegos.com
ADMIN_PASSWORD=reemplazar_por_una_passkey

# Modo debug: True en desarrollo, False en produccion (Render)
FLASK_DEBUG=True
